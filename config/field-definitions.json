{
  "version": "1.0.0",
  "evidence_types": [
    "direct_source",
    "calculated",
    "estimate",
    "hypothesis"
  ],
  "confidence_levels": [
    "high",
    "medium",
    "low",
    "unverified"
  ],
  "access_statuses": [
    "accessible",
    "partial",
    "blocked",
    "not_verified"
  ],
  "tables": {
    "sources": {
      "id_field": "source_id",
      "fields": ["source_id", "url", "title", "publisher", "source_type", "accessed_at", "published_at", "access_status", "collection_method", "content_hash", "limitations", "notes"],
      "required": ["source_id", "url", "title", "source_type", "accessed_at", "access_status", "collection_method"],
      "enums": {"access_status": ["accessible", "partial", "blocked", "not_verified"]},
      "foreign_keys": {}
    },
    "observations": {
      "id_field": "observation_id",
      "fields": ["observation_id", "source_id", "entity_type", "entity_id", "attribute", "observed_value", "unit", "observed_at", "published_at", "evidence_excerpt", "collection_method", "confidence", "limitations"],
      "required": ["observation_id", "source_id", "entity_type", "entity_id", "attribute", "observed_value", "observed_at", "collection_method", "confidence"],
      "enums": {"confidence": ["high", "medium", "low", "unverified"]},
      "foreign_keys": {"source_id": {"table": "sources", "field": "source_id"}}
    },
    "products": {
      "id_field": "product_id",
      "fields": ["product_id", "product_name", "category", "seller_name", "product_url", "price_value", "currency", "price_observed_at", "commission_value", "commission_type", "commission_source_id", "customer_problem", "benefits_observed", "video_potential", "competition_notes", "evidence_type", "confidence", "limitations"],
      "required": ["product_id", "product_name", "category", "evidence_type", "confidence"],
      "enums": {"evidence_type": ["direct_source", "calculated", "estimate", "hypothesis"], "confidence": ["high", "medium", "low", "unverified"]},
      "foreign_keys": {"commission_source_id": {"table": "sources", "field": "source_id"}}
    },
    "competitors": {
      "id_field": "competitor_id",
      "fields": ["competitor_id", "platform", "handle_or_name", "profile_url", "niche", "observed_at", "public_metrics", "metrics_observed_at", "content_patterns", "confidence", "limitations"],
      "required": ["competitor_id", "platform", "handle_or_name", "profile_url", "observed_at", "confidence"],
      "enums": {"confidence": ["high", "medium", "low", "unverified"]},
      "foreign_keys": {}
    },
    "videos": {
      "id_field": "video_id",
      "fields": ["video_id", "competitor_id", "video_url", "published_at", "observed_at", "views_observed", "likes_observed", "comments_observed", "hook_observed", "story_structure", "product_presentation", "call_to_action", "affiliate_disclosure", "evidence_type", "confidence", "limitations"],
      "required": ["video_id", "competitor_id", "video_url", "observed_at", "evidence_type", "confidence"],
      "enums": {"evidence_type": ["direct_source", "calculated", "estimate", "hypothesis"], "confidence": ["high", "medium", "low", "unverified"]},
      "foreign_keys": {"competitor_id": {"table": "competitors", "field": "competitor_id"}}
    },
    "findings": {
      "id_field": "finding_id",
      "fields": ["finding_id", "finding_text", "source_ids", "observation_ids", "evidence_type", "calculation_method", "confidence", "limitations", "created_at", "status"],
      "required": ["finding_id", "finding_text", "evidence_type", "confidence", "created_at", "status"],
      "enums": {"evidence_type": ["direct_source", "calculated", "estimate", "hypothesis"], "confidence": ["high", "medium", "low", "unverified"], "status": ["draft", "audited", "accepted", "rejected"]},
      "foreign_keys": {}
    },
    "hypotheses": {
      "id_field": "hypothesis_id",
      "fields": ["hypothesis_id", "hypothesis", "basis_finding_ids", "target_audience", "proposed_test", "success_metric", "required_data", "status", "limitations"],
      "required": ["hypothesis_id", "hypothesis", "basis_finding_ids", "target_audience", "proposed_test", "success_metric", "required_data", "status"],
      "enums": {"status": ["unverified", "testing", "supported", "rejected"]},
      "foreign_keys": {}
    },
    "audit_findings": {
      "id_field": "audit_id",
      "fields": ["audit_id", "record_type", "record_id", "audit_rule", "result", "issue", "recommended_action", "audited_at"],
      "required": ["audit_id", "record_type", "record_id", "audit_rule", "result", "issue", "recommended_action", "audited_at"],
      "enums": {"result": ["pass", "warning", "fail"]},
      "foreign_keys": {}
    }
  }
}
